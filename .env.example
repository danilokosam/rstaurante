# Copy to .env and adjust. Never commit .env.
# Full reference: docs/operations/environment.md

# PostgreSQL connection string (local Docker: `docker compose up -d`).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/rstaurante

# Used only by the test suites. The database name MUST end with "_test":
# tests refuse to run against any other database because they delete data.
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:5433/rstaurante_test

# Secret used by Payload to sign auth tokens. At least 32 characters.
# Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public URL of this instance (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Object storage (Supabase Storage S3 API). Optional in development: leave all
# empty to store uploads on local disk. If any is set, all must be set.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
